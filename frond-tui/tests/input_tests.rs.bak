//! Tests for input handling and key processing
//!
//! This module tests the input system including KeyChord creation and KeyMapping functionality.

use frond::app::{EditMode, Mode};
use frond::config::Config;
use frond::input::{InputHandler, KeyChord, KeyMapping};
use ratatui::crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
use uuid::Uuid;

#[test]
fn key_chord_new_creates_chord_with_key_and_modifiers() {
    let chord = KeyChord::new(KeyCode::Char('e'), KeyModifiers::CONTROL);

    assert_eq!(chord.key, KeyCode::Char('e'));
    assert_eq!(chord.modifiers, KeyModifiers::CONTROL);
}

#[test]
fn key_chord_char_creates_simple_character_chord() {
    let chord = KeyChord::char('e');

    assert_eq!(chord.key, KeyCode::Char('e'));
    assert_eq!(chord.modifiers, KeyModifiers::NONE);
}

#[test]
fn key_chord_ctrl_creates_control_modified_chord() {
    let chord = KeyChord::ctrl('p');

    assert_eq!(chord.key, KeyCode::Char('p'));
    assert_eq!(chord.modifiers, KeyModifiers::CONTROL);
}

#[test]
fn key_chord_shift_creates_shift_modified_chord() {
    let chord = KeyChord::shift('a');

    assert_eq!(chord.key, KeyCode::Char('a'));
    assert_eq!(chord.modifiers, KeyModifiers::SHIFT);
}

#[test]
fn key_chord_alt_creates_alt_modified_chord() {
    let chord = KeyChord::alt('f');

    assert_eq!(chord.key, KeyCode::Char('f'));
    assert_eq!(chord.modifiers, KeyModifiers::ALT);
}

#[test]
fn key_chord_supports_all_printable_characters() {
    let test_chars = vec![
        'a', 'z', 'A', 'Z', '0', '9', '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '-', '=',
        '[', ']', '\\', ';', '\'', ',', '.', '/', '`', '~',
    ];

    for c in test_chars {
        let chord = KeyChord::char(c);
        assert_eq!(chord.key, KeyCode::Char(c));
        assert_eq!(chord.modifiers, KeyModifiers::NONE);
    }
}

#[test]
fn key_chord_question_mark_creates_correct_chord() {
    let chord = KeyChord::char('?');

    assert_eq!(chord.key, KeyCode::Char('?'));
    assert_eq!(chord.modifiers, KeyModifiers::NONE);
}

#[test]
fn key_chord_space_creates_correct_chord() {
    let chord = KeyChord::char(' ');

    assert_eq!(chord.key, KeyCode::Char(' '));
    assert_eq!(chord.modifiers, KeyModifiers::NONE);
}

#[test]
fn key_chord_equality_works_correctly() {
    let chord1 = KeyChord::char('e');
    let chord2 = KeyChord::char('e');
    let chord3 = KeyChord::char('f');
    let chord4 = KeyChord::ctrl('e');

    assert_eq!(chord1, chord2);
    assert_ne!(chord1, chord3);
    assert_ne!(chord1, chord4);
}

#[test]
fn key_chord_can_be_used_as_hash_key() {
    use std::collections::HashMap;

    let mut map = HashMap::new();
    let chord1 = KeyChord::char('e');
    let chord2 = KeyChord::ctrl('p');

    map.insert(chord1, "edit");
    map.insert(chord2, "command_palette");

    assert_eq!(map.get(&KeyChord::char('e')), Some(&"edit"));
    assert_eq!(map.get(&KeyChord::ctrl('p')), Some(&"command_palette"));
    assert_eq!(map.get(&KeyChord::char('x')), None);
}

#[test]
fn key_mapping_creates_from_default_config() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    // Should have mappings for at least Normal mode
    assert!(mapping.mode_mappings.contains_key(&Mode::Normal));
}

#[test]
fn key_mapping_normal_mode_contains_expected_actions() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    let normal_mappings = mapping.mode_mappings.get(&Mode::Normal).unwrap();

    // Should contain common navigation actions
    assert!(normal_mappings.values().any(|action| action == "scroll_up"));
    assert!(
        normal_mappings
            .values()
            .any(|action| action == "scroll_down")
    );
    assert!(
        normal_mappings
            .values()
            .any(|action| action == "edit_message")
    );
    assert!(
        normal_mappings
            .values()
            .any(|action| action == "delete_message")
    );
}

#[test]
fn key_mapping_get_action_id_returns_correct_action_for_normal_mode() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    // Test 'e' key for edit action
    let edit_event = KeyEvent::new(KeyCode::Char('e'), KeyModifiers::NONE);
    let action_id = mapping.get_action_id(Mode::Normal, edit_event);
    assert_eq!(action_id, Some("edit_message".to_string()));

    // Test 'd' key for delete action
    let delete_event = KeyEvent::new(KeyCode::Char('d'), KeyModifiers::NONE);
    let action_id = mapping.get_action_id(Mode::Normal, delete_event);
    assert_eq!(action_id, Some("delete_message".to_string()));
}

#[test]
fn key_mapping_get_action_id_returns_none_for_unmapped_key() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    // Test unmapped key
    let unmapped_event = KeyEvent::new(KeyCode::Char('z'), KeyModifiers::NONE);
    let action_id = mapping.get_action_id(Mode::Normal, unmapped_event);
    assert_eq!(action_id, None);
}

#[test]
fn key_mapping_arrow_keys_mapped_correctly() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    let up_event = KeyEvent::new(KeyCode::Up, KeyModifiers::NONE);
    let down_event = KeyEvent::new(KeyCode::Down, KeyModifiers::NONE);
    let left_event = KeyEvent::new(KeyCode::Left, KeyModifiers::NONE);
    let right_event = KeyEvent::new(KeyCode::Right, KeyModifiers::NONE);

    let up_action = mapping.get_action_id(Mode::Normal, up_event);
    let down_action = mapping.get_action_id(Mode::Normal, down_event);
    let left_action = mapping.get_action_id(Mode::Normal, left_event);
    let right_action = mapping.get_action_id(Mode::Normal, right_event);

    assert_eq!(up_action, Some("scroll_up".to_string()));
    assert_eq!(down_action, Some("scroll_down".to_string()));
    assert_eq!(left_action, Some("prev_branch".to_string()));
    assert_eq!(right_action, Some("next_branch".to_string()));
}

#[test]
fn key_mapping_ctrl_p_mapped_to_command_palette() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    let ctrl_p = KeyEvent::new(KeyCode::Char('p'), KeyModifiers::CONTROL);
    let action_id = mapping.get_action_id(Mode::Normal, ctrl_p);

    assert_eq!(action_id, Some("command_palette".to_string()));
}

#[test]
fn key_mapping_escape_mapped_to_exit_mode_in_edit() {
    let config = Config::default();
    let mapping = KeyMapping::from_config(&config);

    let escape = KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE);
    let action_id = mapping.get_action_id(Mode::Edit(EditMode::Append), escape);

    assert_eq!(action_id, Some("exit_mode".to_string()));
}

#[test]
fn input_handler_creates_with_config() {
    let config = Config::default();
    let handler = InputHandler::new(&config);

    // Should not panic and should create successfully
    // Test that we can get essential schemas
    let schemas = handler.get_essential_schemas(Mode::Normal);
    assert!(!schemas.is_empty());
}

#[test]
fn input_handler_handles_global_quit_key() {
    let config = Config::default();
    let handler = InputHandler::new(&config);

    let q = KeyEvent::new(KeyCode::Char('q'), KeyModifiers::NONE);
    let action = handler.handle_input(q, Mode::Normal, None);

    match action {
        Some(frond::actions::UIAction::Common(frond::actions::CommonAction::Quit)) => {} // Expected
        other => panic!("Expected Quit action, got {:?}", other),
    }
}

#[test]
fn input_handler_handles_mode_specific_keys() {
    let config = Config::default();
    let handler = InputHandler::new(&config);

    // Test edit key in normal mode
    let e_key = KeyEvent::new(KeyCode::Char('e'), KeyModifiers::NONE);
    let action = handler.handle_input(e_key, Mode::Normal, Some(Uuid::new_v4()));

    assert!(action.is_some());
    match action.unwrap() {
        frond::actions::UIAction::NormalMode(frond::actions::NormalModeAction::EnterEditMode(
            _,
        )) => {} // Expected
        other => panic!("Expected EnterEditMode action, got {:?}", other),
    }
}

#[test]
fn input_handler_returns_none_for_unmapped_keys() {
    let config = Config::default();
    let handler = InputHandler::new(&config);

    let unmapped_key = KeyEvent::new(KeyCode::Char('z'), KeyModifiers::NONE);
    let action = handler.handle_input(unmapped_key, Mode::Normal, None);

    assert!(action.is_none());
}

#[test]
fn input_handler_resolves_context_dependent_actions() {
    let config = Config::default();
    let handler = InputHandler::new(&config);

    let message_id = Uuid::new_v4();
    let e_key = KeyEvent::new(KeyCode::Char('e'), KeyModifiers::NONE);

    // With focus
    let action_with_focus = handler.handle_input(e_key, Mode::Normal, Some(message_id));

    // Without focus
    let action_without_focus = handler.handle_input(e_key, Mode::Normal, None);

    match action_with_focus {
        Some(frond::actions::UIAction::NormalMode(
            frond::actions::NormalModeAction::EnterEditMode(id),
        )) => {
            assert_eq!(id, message_id);
        }
        other => panic!("Expected EnterEditMode with message ID, got {:?}", other),
    }

    match action_without_focus {
        Some(frond::actions::UIAction::NormalMode(
            frond::actions::NormalModeAction::EnterEditMode(id),
        )) => {
            assert_eq!(id, Uuid::nil());
        }
        other => panic!("Expected EnterEditMode with nil ID, got {:?}", other),
    }
}

#[test]
fn key_chord_with_special_keys() {
    let special_keys = vec![
        KeyCode::Enter,
        KeyCode::Esc,
        KeyCode::Tab,
        KeyCode::Backspace,
        KeyCode::Delete,
        KeyCode::Home,
        KeyCode::End,
        KeyCode::PageUp,
        KeyCode::PageDown,
    ];

    for key in special_keys {
        let chord = KeyChord::new(key, KeyModifiers::NONE);
        assert_eq!(chord.key, key);
        assert_eq!(chord.modifiers, KeyModifiers::NONE);

        // Test with ctrl modifier
        let ctrl_chord = KeyChord::new(key, KeyModifiers::CONTROL);
        assert_eq!(ctrl_chord.key, key);
        assert!(ctrl_chord.modifiers.contains(KeyModifiers::CONTROL));
    }
}

#[test]
fn key_chord_is_cloneable() {
    let original = KeyChord::ctrl('c');
    let cloned = original.clone();

    assert_eq!(original.key, cloned.key);
    assert_eq!(original.modifiers, cloned.modifiers);
}

#[test]
fn key_chord_is_debuggable() {
    let chord = KeyChord::ctrl('p');
    let debug_str = format!("{:?}", chord);

    assert!(debug_str.contains("KeyChord"));
    // The exact format may vary, but it should contain meaningful information
}
